<Page x:Class="Inventory.AddStockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F5F9"
      FontFamily="Segoe UI">

    <Page.Resources>
        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Hint Style -->
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Input Style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- Dropdown Style -->
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button Style -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Page Header -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Add Stock"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Fill in the details below to register a new stock item"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form Card -->
            <Border Background="White"
                    CornerRadius="8"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="32"
                    MaxWidth="580"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="1"
                                      Opacity="0.08"
                                      Color="#000000"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Card Header -->
                    <TextBlock Text="Item Information"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="All fields marked with * are required"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,0,0,24"/>

                    <!-- Divider -->
                    <Border Background="#E2E8F0"
                            Height="1"
                            Margin="0,0,0,24"/>

                    <!-- Row 1: Serial Number + Model Number -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Serial Number -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Serial Number *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSerialNumber" Style="{StaticResource InputBox}"/>
                        </StackPanel>

                        <!-- Model Number -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Model Number *" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtModelNumber" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Product Name -->
                    <TextBlock Text="Product Name *" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtProductName" Style="{StaticResource InputBox}"/>

                    <!-- Row 2: Category + Warranty -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbCategory" Style="{StaticResource InputCombo}">
                                <ComboBoxItem Content="Cameras"/>
                                <ComboBoxItem Content="DVR"/>
                                <ComboBoxItem Content="NVR"/>
                                <ComboBoxItem Content="POE"/>
                                <ComboBoxItem Content="HDD"/>
                                <ComboBoxItem Content="Adaptor"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Warranty -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Warranty *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbWarranty" Style="{StaticResource InputCombo}">
                                <ComboBoxItem Content="No Warranty"/>
                                <ComboBoxItem Content="6 Months"/>
                                <ComboBoxItem Content="1 Year" IsSelected="True"/>
                                <ComboBoxItem Content="2 Years"/>
                                <ComboBoxItem Content="3 Years"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Added By -->
                    <TextBlock Text="Added By *" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="Will be replaced with staff dropdown once database is connected"
                               Style="{StaticResource FieldHint}"/>
                    <TextBox x:Name="txtAddedBy" Style="{StaticResource InputBox}"/>

                    <!-- Divider -->
                    <Border Background="#E2E8F0"
                            Height="1"
                            Margin="0,4,0,20"/>

                    <!-- Error Message -->
                    <Border x:Name="errorBorder"
                            Background="#FEF2F2"
                            CornerRadius="6"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="txtError"
                                   Text=""
                                   Foreground="#DC2626"
                                   FontSize="12"/>
                    </Border>

                    <!-- Success Message -->
                    <Border x:Name="successBorder"
                            Background="#F0FDF4"
                            CornerRadius="6"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="txtSuccess"
                                   Text=""
                                   Foreground="#16A34A"
                                   FontSize="12"/>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnSave"
                                Content="Save Stock"
                                Style="{StaticResource PrimaryBtn}"
                                Click="btnSave_Click"/>
                        <Button x:Name="btnClear"
                                Content="Clear"
                                Style="{StaticResource GhostBtn}"
                                Click="btnClear_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>