<Page x:Class="Inventory.AddStockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Header -->
            <TextBlock Text="Add Stock"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Fill in the details to add a new stock item"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,0,0,32"/>

            <!-- Form Card -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="32"
                    MaxWidth="600"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="10" ShadowDepth="1"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Item Name -->
                    <TextBlock Text="Item Name *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtItemName"
                             Height="42"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             Margin="0,0,0,18"/>

                    <!-- Category -->
                    <TextBlock Text="Category *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtCategory"
                             Height="42"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             Margin="0,0,0,18"/>

                    <!-- Quantity -->
                    <TextBlock Text="Quantity *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtQuantity"
                             Height="42"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             Margin="0,0,0,18"/>

                    <!-- Description -->
                    <TextBlock Text="Description"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="txtDescription"
                             Height="90"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,24"/>

                    <!-- Error Message -->
                    <TextBlock x:Name="txtError"
                               Text=""
                               Foreground="#EF4444"
                               FontSize="12"
                               Margin="0,0,0,12"/>

                    <!-- Success Message -->
                    <TextBlock x:Name="txtSuccess"
                               Text=""
                               Foreground="#22C55E"
                               FontSize="12"
                               Margin="0,0,0,12"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">

                        <Button x:Name="btnSave"
                                Content="✅ Save Stock"
                                Height="42"
                                Padding="24,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Background="#3B82F6"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,12,0"
                                Click="btnSave_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="btnClear"
                                Content="🗑️ Clear"
                                Height="42"
                                Padding="24,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#64748B"
                                Background="#F1F5F9"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnClear_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>