<Window x:Class="Inventory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory System"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        >

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="240"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0"
                Background="#1E293B">
            <DockPanel>

                <!-- Logo Area -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,32,0,32">

                    <Image Source="inventory.png"
                               Width="60"
                               Height="60"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Inventory"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Management System"
                               FontSize="11"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Nav Items -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="16,0">

                    <!-- Dashboard -->
                    <Button x:Name="btnDashboard"
                            Tag="Dashboard"
                            Click="NavButton_Click"
                            Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏠"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Dashboard"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Stocks -->
                    <Button x:Name="btnStocks"
                            Tag="Stocks"
                            Click="NavButton_Click"
                            Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📦"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Stocks"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Requests -->
                    <Button x:Name="btnRequests"
                            Tag="Requests"
                            Click="NavButton_Click"
                            Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Requests"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Returns -->
                    <Button x:Name="btnReturns"
                            Tag="Returns"
                            Click="NavButton_Click"
                            Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↩️"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Returns"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Add Stock -->
                    <Button x:Name="btnAddStock"
                            Tag="AddStock"
                            Click="NavButton_Click"
                            Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Stock"
                               Foreground="White"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Add Request -->
                    <Button x:Name="btnAddRequest"
                            Tag="AddRequest"
                            Click="NavButton_Click"
                            Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Request"
                               Foreground="White"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Add Return -->
                    <Button x:Name="btnAddReturn"
        Tag="AddReturn"
        Click="NavButton_Click"
        Margin="0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="navBorder"
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="↩️"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Return"
                               Foreground="White"
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>

                <!-- Logout Button at Bottom -->
                <StackPanel DockPanel.Dock="Bottom"
                            Margin="16,0,16,24">
                    <Button x:Name="btnLogout"
                            Click="btnLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="logoutBorder"
                                        Background="#EF444420"
                                        CornerRadius="8"
                                        Padding="16,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Logout"
                                                   Foreground="#EF4444"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="logoutBorder" Property="Background" Value="#EF444440"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Border Grid.Column="1"
                Background="#F1F5F9"
                Padding="32">

            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"/>

        </Border>

    </Grid>
</Window>