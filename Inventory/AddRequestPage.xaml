<Page x:Class="Inventory.AddRequestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F5F9">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Header -->
            <TextBlock Text="Add Request"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Fill in the details to submit a new request"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,0,0,32"/>

            <!-- Form Card -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="32"
                    MaxWidth="600"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="10" ShadowDepth="1"/>
                </Border.Effect>

                <StackPanel>

                    <!-- Requested Items -->
                    <TextBlock Text="Requested Items *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="List all items separated by comma (e.g. IP Camera x2, NVR 8ch, POE)"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtRequestedItems"
                             Height="90"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,18"/>

                    <!-- Requested By -->
                    <TextBlock Text="Requested By *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Enter full name and position (e.g. Technical Engr. Edcel)"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtRequestedBy"
                             Height="42"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             Margin="0,0,0,18"/>

                    <!-- Quantity -->
                    <TextBlock Text="Total Quantity *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Total number of items requested"
                               FontSize="11"
                               Foreground="#94A3B8"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="txtQuantity"
                             Height="42"
                             Padding="12,10"
                             FontSize="13"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="#F8FAFC"
                             Margin="0,0,0,18"/>

                    <!-- Status -->
                    <TextBlock Text="Status *"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbStatus"
                              Height="42"
                              Padding="12,10"
                              FontSize="13"
                              BorderBrush="#CBD5E1"
                              BorderThickness="1"
                              Background="#F8FAFC"
                              Margin="0,0,0,24">
                        <ComboBoxItem Content="Pending" IsSelected="True"/>
                        <ComboBoxItem Content="Completed"/>
                    </ComboBox>

                    <!-- Error -->
                    <TextBlock x:Name="txtError"
                               Text=""
                               Foreground="#EF4444"
                               FontSize="12"
                               Margin="0,0,0,12"/>

                    <!-- Success -->
                    <TextBlock x:Name="txtSuccess"
                               Text=""
                               Foreground="#22C55E"
                               FontSize="12"
                               Margin="0,0,0,12"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="✅ Save Request"
                                Height="42" Padding="24,0"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="White" Background="#0F172A"
                                BorderThickness="0" Cursor="Hand"
                                Margin="0,0,12,0"
                                Click="btnSave_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="🗑️ Clear"
                                Height="42" Padding="24,0"
                                FontSize="13" FontWeight="SemiBold"
                                Foreground="#64748B" Background="#F1F5F9"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnClear_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>