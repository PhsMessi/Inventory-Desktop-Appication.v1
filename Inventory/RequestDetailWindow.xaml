<Window x:Class="Inventory.RequestDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Request Details"
        Height="520" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Request Details"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock Text="Review the request information below"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Card -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
            </Border.Effect>

            <StackPanel>

                <!-- Status Badge -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,16">
                    <Border x:Name="statusBadge"
                            CornerRadius="20"
                            Padding="14,5">
                        <TextBlock x:Name="txtStatusBadge"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Border Background="#E2E8F0" Height="1" Margin="0,0,0,20"/>

                <!-- Requested Items -->
                <TextBlock Text="REQUESTED ITEMS"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,6"/>
                <Border Background="#F8FAFC"
                        CornerRadius="6"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="txtItems"
                               FontSize="13"
                               Foreground="#0F172A"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </Border>

                <!-- 2 Column Grid -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Requested By -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="REQUESTED BY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC"
                                CornerRadius="6"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Padding="12,10">
                            <TextBlock x:Name="txtRequestedBy"
                                       FontSize="13"
                                       Foreground="#0F172A"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Quantity -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="QUANTITY"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC"
                                CornerRadius="6"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                Padding="12,10">
                            <TextBlock x:Name="txtQuantity"
                                       FontSize="13"
                                       Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Date -->
                <TextBlock Text="DATE SUBMITTED"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#94A3B8"
                           Margin="0,0,0,6"/>
                <Border Background="#F8FAFC"
                        CornerRadius="6"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="12,10">
                    <TextBlock x:Name="txtDate"
                               FontSize="13"
                               Foreground="#0F172A"/>
                </Border>

            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Close Button -->
            <Button Grid.Column="0"
                    Content="Close"
                    Height="42"
                    Margin="0,0,8,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#64748B"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="btnClose_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Approve Button -->
            <Button x:Name="btnApprove"
                    Grid.Column="1"
                    Content="✅ Approve Request"
                    Height="42"
                    Margin="8,0,0,0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#16A34A"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnApprove_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Grid>
</Window>