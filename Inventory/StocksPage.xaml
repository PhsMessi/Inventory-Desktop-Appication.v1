<Page x:Class="Inventory.StocksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F1F5F9">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Table -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Stocks"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Manage your inventory items"
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Category Tabs -->
        <Border Grid.Row="1"
        Background="White"
        CornerRadius="8"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        Padding="6"
        Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">

                <Button x:Name="tabAll" Content="All"
                Tag="All" Click="TabButton_Click"
                Margin="0,0,4,0" Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="#0F172A" Foreground="#F8FAFC">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="tabCameras" Content="Cameras"
                Tag="Cameras" Click="TabButton_Click"
                Margin="0,0,4,0" Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="Transparent" Foreground="#64748B">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="tabDVR" Content="DVR"
                Tag="DVR" Click="TabButton_Click"
                Margin="0,0,4,0" Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="Transparent" Foreground="#64748B">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="tabNVR" Content="NVR"
                Tag="NVR" Click="TabButton_Click"
                Margin="0,0,4,0" Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="Transparent" Foreground="#64748B">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="tabPOE" Content="POE"
                Tag="POE" Click="TabButton_Click"
                Margin="0,0,4,0" Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="Transparent" Foreground="#64748B">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="tabHDD" Content="HDD"
                Tag="HDD" Click="TabButton_Click"
                Margin="0,0,4,0" Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="Transparent" Foreground="#64748B">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="tabAdaptor" Content="Adaptor"
                Tag="Adaptor" Click="TabButton_Click"
                Padding="16,8"
                FontSize="13" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand"
                Background="Transparent" Foreground="#64748B">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="tabBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tabBorder" Property="Background" Value="#F1F5F9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
        <!-- Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Background="White"
                    CornerRadius="8"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="12,0"
                    Grid.Column="0"
                    Margin="0,0,12,0">
                <TextBox x:Name="txtSearch"
                         Height="38"
                         BorderThickness="0"
                         FontSize="13"
                         Foreground="#1E293B"
                         VerticalContentAlignment="Center"
                         TextChanged="txtSearch_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Resources>
                                <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.5" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍  Search stocks..."
                                                   Foreground="#94A3B8"
                                                   FontSize="13"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Style.Resources>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            
        </Grid>

        <!-- Table -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect Color="#CCCCCC" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>

            <DataGrid x:Name="dgStocks"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      FontSize="13"
                      ColumnHeaderHeight="44"
                      RowHeight="44"
                      SelectionMode="Single"
                      Margin="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="16,0"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Serial Number -->
                    <DataGridTextColumn Header="#" Binding="{Binding SerialNumber}" Width="55"/>
                    <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="130"/>
                    <DataGridTextColumn Header="Model Number" Binding="{Binding ModelNumber}" Width="130"/>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                    <DataGridTextColumn Header="Added By" Binding="{Binding AddedBy}" Width="130"/>
                    <DataGridTextColumn Header="Warranty" Binding="{Binding Warranty}" Width="110"/>
                    <DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>