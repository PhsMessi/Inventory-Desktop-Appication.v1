<Window x:Class="Inventory.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory System — Login"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F0F4F8">

    <Grid>
        <!-- Centered Card -->
        <Border Background="White"
                CornerRadius="16"
                Width="400"
                Padding="48,40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#AAAAAA" BlurRadius="30" ShadowDepth="3"/>
            </Border.Effect>

            <StackPanel>

                <!-- Icon -->
                <!-- Logo -->
                <Image Source="inventory.png"
                             Width="80"
                             Height="80"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,8"/>

                <!-- Title -->
                <TextBlock Text="Inventory System"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Admin Login"
                           FontSize="13"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,32"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="txtUsername"
                         Height="42"
                         Padding="12,10"
                         FontSize="13"
                         Background="#F8FAFC"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Margin="0,0,0,18"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="txtPassword"
                             Height="42"
                             Padding="12,10"
                             FontSize="13"
                             Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Margin="0,0,0,10"/>

                <!-- Error Message -->
                <TextBlock x:Name="txtError"
                           Text=""
                           Foreground="#EF4444"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <!-- Login Button -->
                <Button x:Name="btnLogin"
                        Content="Login"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="btnLogin_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>